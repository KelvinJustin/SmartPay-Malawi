// ==========================================
// GENERATOR & DATASOURCE CONFIGURATION
// ==========================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMERATIONS
// ==========================================

// Defines the intended use case for a generated One-Time Password (OTP).
enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
}

// Tracks the lifecycle and compliance approval stage of a merchant account.
enum AccountStatus {
  PENDING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// Identifies the actor responsible for changing a merchant profile or review state.
enum ProfileActorType {
  MERCHANT
  ADMIN
  SYSTEM
}

// Classifies the legal structure of a merchant business entity.
enum BusinessType {
  INDIVIDUAL
  SOLE_TRADER
  PARTNERSHIP
  LIMITED_COMPANY
  NGO
}

// Categorizes KYC / compliance documents uploaded by merchants.
enum DocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  PROOF_OF_ADDRESS
  DIRECTOR_ID
}

// Tracks the verification status of an uploaded compliance document.
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// Defines administrative roles and permission tiers within the platform.
enum AdminRole {
  SUPER_ADMIN
  COMPLIANCE
  OPERATIONS
  SUPPORT
}

// Tracks whether an admin account is active or suspended.
enum AdminStatus {
  ACTIVE
  SUSPENDED
}

// Tracks the overall financial status of a payment transaction.
enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  PENDING_RECONCILIATION
}

// Tracks the lifecycle state of a hosted checkout session URL.
enum CheckoutSessionStatus {
  ACTIVE
  EXPIRED
  CONSUMED
  REVOKED
}

// Supported mobile money and payment network providers in Malawi.
enum PaymentProvider {
  AIRTEL_MONEY
  TN_MPAMBA    @map("TNM_MPAMBA")
  TEST
}

// Tracks the granular status of an individual payment gateway attempt.
enum PaymentAttemptStatus {
  STARTED
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
}

// ==========================================
// CORE DOMAIN MODELS
// ==========================================

// Auth identity only. Business details → MerchantProfile, balances → MerchantLedger.
model Merchant {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String
  phone           String    @unique
  pinHash         String?
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  otpChallenges       OtpChallenge[]
  revokedTokens       RevokedToken[]
  profile             MerchantProfile?
  ledger              MerchantLedger?
  paymentTransactions PaymentTransaction[]

  @@map("merchants")
}

// Amounts are stored in integer tambala (1 MWK = 100 tambala).
// A succeeded payment does not automatically settle to the ledger.
model PaymentTransaction {
  id                String           @id @default(uuid()) @db.Uuid
  publicReference   String           @unique // Solaris-generated; never expose the DB id externally.
  merchantId        String           @db.Uuid
  // Amount stored in the smallest MWK unit: 100 tambala = MWK 1.00.
  amountTambala     Int              @map("amount")
  currency          String           @default("MWK")
  status            PaymentStatus    @default(CREATED)
  provider          PaymentProvider? // Null until a provider is selected.
  providerReference String?
  customerPhone     String?
  description       String?
  merchantReference String?
  idempotencyKey    String // Deduplicates retried requests; scoped per merchant.

  // Sanitised diagnostics only — never store credentials or tokens here.
  failureCode    String?
  failureMessage String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  attempts         PaymentAttempt[]
  checkoutSessions CheckoutSession[]

  @@unique([merchantId, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([merchantId, createdAt])
  @@index([status, createdAt])
  @@index([merchantId, merchantReference])
  @@map("payment_transactions")
}

// One row per provider call. Attempts are never overwritten so the full
// call history is preserved even when a transaction is retried.
model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  transactionId     String               @db.Uuid
  attemptNumber     Int
  provider          PaymentProvider
  status            PaymentAttemptStatus @default(STARTED)
  providerReference String?
  failureCode       String?
  failureMessage    String?
  startedAt         DateTime             @default(now())
  completedAt       DateTime?

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId, attemptNumber])
  @@index([provider, providerReference])
  @@index([status, startedAt])
  @@map("payment_attempts")
}

// Privileged platform identity. Provisioned internally — no public registration.
model Admin {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(SUPPORT)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  approvedProfiles   MerchantProfile[]   @relation("ProfileApprovedBy")
  reviewedDocuments  MerchantDocument[]  @relation("DocumentReviewedBy")
  adminRevokedTokens AdminRevokedToken[]

  @@index([role, status])
  @@map("admins")
}

// Manages short-lived verification and authentication OTP challenges for merchants.
model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  merchantId String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  sentAt     DateTime   @default(now())
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// Blacklist store for revoked merchant JWT refresh/access tokens (identified by jti).
model RevokedToken {
  id         String   @id @default(uuid()) @db.Uuid
  jti        String   @unique @db.Uuid
  merchantId String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("revoked_tokens")
}

// Separate table so admin token revocations are isolated from merchant ones.
model AdminRevokedToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique @db.Uuid
  adminId   String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_revoked_tokens")
}

// Created automatically on registration but starts empty.
// Only admins may advance accountStatus past SUBMITTED.
model MerchantProfile {
  id         String @id @default(uuid()) @db.Uuid
  merchantId String @unique @db.Uuid

  businessName           String?
  tradingName            String?
  businessType           BusinessType?
  businessRegistrationNo String?
  taxIdentificationNo    String? // MRA TPIN
  merchantCategoryCode   String? // ISO 18245 MCC e.g. "5411"
  industryDescription    String?

  supportEmail String?
  supportPhone String?
  websiteUrl   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  country      String  @default("MW")

  logoUrl String?

  accountStatus   AccountStatus @default(PENDING_SUBMISSION)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  approvedBy    Admin?                  @relation("ProfileApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  documents     MerchantDocument[]
  reviewHistory MerchantReviewHistory[]

  @@map("merchant_profiles")
}

// Each uploaded file is its own row. Multiple documents of the same type
// are allowed; use supersededByDocumentId to track which is current.
model MerchantDocument {
  id            String         @id @default(uuid()) @db.Uuid
  profileId     String         @db.Uuid
  type          DocumentType
  status        DocumentStatus @default(PENDING)
  fileUrl       String
  fileKey       String
  mimeType      String
  fileSizeBytes Int
  rejectionNote String?
  reviewedAt    DateTime?
  reviewedById  String?        @db.Uuid
  expiresAt     DateTime?
  uploadedAt    DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supersededAt           DateTime?
  supersededByDocumentId String?   @db.Uuid

  profile    MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewedBy Admin?          @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  supersededBy MerchantDocument?  @relation("DocumentSupersession", fields: [supersededByDocumentId], references: [id], onDelete: SetNull)
  supersedes   MerchantDocument[] @relation("DocumentSupersession")

  @@index([profileId, type])
  @@index([status])
  @@index([supersededByDocumentId])
  @@map("merchant_documents")
}

// Append-only audit log of every accountStatus transition. Never mutate rows.
model MerchantReviewHistory {
  id         String           @id @default(uuid()) @db.Uuid
  profileId  String           @db.Uuid
  fromStatus AccountStatus
  toStatus   AccountStatus
  note       String?
  actorType  ProfileActorType
  actorId    String?          @db.Uuid
  createdAt  DateTime         @default(now())

  profile MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([actorType, actorId])
  @@map("merchant_review_history")
}

// Balances in integer tambala (1 MWK = 100 tambala).
// availableBalance = settled funds; pendingBalance = not yet settled.
model MerchantLedger {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @unique @db.Uuid
  availableBalance Int      @default(0)
  pendingBalance   Int      @default(0)
  currency         String   @default("MWK")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_ledgers")
}

// Stores encrypted payment checkout session tokens and tracks their lifecycle.
model CheckoutSession {
  id             String                @id @default(uuid()) @db.Uuid
  transactionId  String                @db.Uuid
  tokenHash      String                @unique
  tokenEncrypted String
  status         CheckoutSessionStatus @default(ACTIVE)

  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, status])
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}
