# ============================================================
# SMARTPAY MALAWI — ENVIRONMENT CONFIGURATION
# ============================================================
# Setup:
# 1. Copy this file to `.env` in the project root.
# 2. Replace all placeholders with your actual configuration.
# 3. Never commit `.env` or production secrets to Git.
# 4. Keep `.env.example` free of real credentials.
# 5. Restart the API after changing environment variables.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

# NestJS API listening port.
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development


# ------------------------------------------------------------
# DATABASE — POSTGRESQL / PRISMA
# ------------------------------------------------------------

# PostgreSQL connection string.
# Use the Neon connection string for your hosted database.
# Encode special characters in credentials where necessary.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"


# ------------------------------------------------------------
# REDIS — CACHE / BACKGROUND JOBS
# ------------------------------------------------------------

# Local development: localhost
# Docker Compose: use the Redis service name, e.g. redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# Uncomment only when Redis authentication is configured.
# REDIS_PASSWORD=replace_with_redis_password


# ------------------------------------------------------------
# PASSWORD SECURITY
# ------------------------------------------------------------

# Bcrypt work factor.
# The application must explicitly read PASS_SALTS.
ENCYTPION_SALT=10


# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------

# Generate a unique secret for each environment.
# Example generation command:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret

# Access token lifetime. Keep aligned with JwtModule configuration.
JWT_EXPIRES_IN=15m


# ------------------------------------------------------------
# EMAIL DELIVERY — SMTP
# ------------------------------------------------------------

# SMTP server hostname supplied by your email provider.
SMTP_HOST=

# Usually 587 for STARTTLS or 465 for implicit TLS.
SMTP_PORT=587

# SMTP account credentials.
SMTP_USER=
SMTP_PASS=

# Sender address, e.g. SmartPay Malawi <no-reply@example.com>
SMTP_FROM=


# ------------------------------------------------------------
# EMAIL VERIFICATION & TWO-FACTOR AUTHENTICATION
# ------------------------------------------------------------

# OTP lifetime in seconds.
OTP_TTL_SECONDS=300

# Minimum wait between OTP send/resend requests, in seconds.
OTP_RESEND_COOLDOWN_SECONDS=60

# Maximum incorrect OTP submissions per challenge.
OTP_MAX_ATTEMPTS=5

# Secret used to HMAC OTP values before storing their hashes.
# Generate a separate random secret; do not reuse JWT_SECRET.
# Example generation command:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=replace_with_a_separate_random_secret


# ============================================================
# END OF EXAMPLE CONFIGURATION
# ============================================================