generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
}

// KYC/onboarding lifecycle — lives on MerchantProfile, not Merchant.
enum AccountStatus {
  PENDING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProfileActorType {
  MERCHANT
  ADMIN
  SYSTEM
}

enum BusinessType {
  INDIVIDUAL
  SOLE_TRADER
  PARTNERSHIP
  LIMITED_COMPANY
  NGO
}

enum DocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  PROOF_OF_ADDRESS
  DIRECTOR_ID
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AdminRole {
  SUPER_ADMIN
  COMPLIANCE
  OPERATIONS
  SUPPORT
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

// ============================================================
// MERCHANT
// ============================================================

// Auth identity only — no business details, KYC, or balances.
// Those live on MerchantProfile and MerchantLedger respectively.
model Merchant {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String
  phone           String    @unique
  pinHash         String?
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  otpChallenges OtpChallenge[]
  revokedTokens RevokedToken[]
  profile       MerchantProfile?
  ledger        MerchantLedger?

  @@map("merchants")
}

// ============================================================
// ADMIN
// ============================================================

// Privileged platform identity — separate from merchants.
// Admin accounts must be provisioned internally; no public registration.
model Admin {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(SUPPORT)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  approvedProfiles   MerchantProfile[]   @relation("ProfileApprovedBy")
  reviewedDocuments  MerchantDocument[]  @relation("DocumentReviewedBy")
  adminRevokedTokens AdminRevokedToken[]

  @@index([role, status])
  @@map("admins")
}

// ============================================================
// OTP
// ============================================================

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  merchantId String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  sentAt     DateTime   @default(now())
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ============================================================
// TOKEN REVOCATION
// ============================================================

model RevokedToken {
  id         String   @id @default(uuid()) @db.Uuid
  jti        String   @unique @db.Uuid
  merchantId String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("revoked_tokens")
}

// Admin sessions are revoked independently of merchant sessions.
model AdminRevokedToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique @db.Uuid
  adminId   String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_revoked_tokens")
}

// ============================================================
// MERCHANT PROFILE
// ============================================================

// Business identity and KYC. Created automatically at registration
// but starts empty — the merchant fills it in before submitting for approval.
model MerchantProfile {
  id         String @id @default(uuid()) @db.Uuid
  merchantId String @unique @db.Uuid

  // Business identity
  businessName           String?
  tradingName            String?
  businessType           BusinessType?
  businessRegistrationNo String?
  taxIdentificationNo    String? // MRA TPIN
  merchantCategoryCode   String? // ISO 18245 MCC e.g. "5411"
  industryDescription    String?

  // Contact and location
  supportEmail String?
  supportPhone String?
  websiteUrl   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  country      String  @default("MW")

  // Branding
  logoUrl String?

  // KYC lifecycle — only admins may transition status past SUBMITTED.
  accountStatus   AccountStatus @default(PENDING_SUBMISSION)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  approvedBy    Admin?                  @relation("ProfileApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  documents     MerchantDocument[]
  reviewHistory MerchantReviewHistory[]

  @@map("merchant_profiles")
}

// ============================================================
// KYC DOCUMENTS
// ============================================================

// One row per document type per profile — enforced by @@unique.
// Re-uploading a rejected document upserts the existing row.
model MerchantDocument {
  id            String         @id @default(uuid()) @db.Uuid
  profileId     String         @db.Uuid
  type          DocumentType
  status        DocumentStatus @default(PENDING)
  fileUrl       String
  fileKey       String // Storage object key used for deletion
  mimeType      String
  fileSizeBytes Int
  rejectionNote String?
  reviewedAt    DateTime?
  reviewedById  String?        @db.Uuid
  expiresAt     DateTime? // For documents with an expiry (e.g. national ID)
  uploadedAt    DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  profile    MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewedBy Admin?          @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([profileId, type])
  @@index([profileId, type])
  @@index([status])
  @@map("merchant_documents")
}

// ============================================================
// REVIEW HISTORY
// ============================================================

// Append-only audit trail of every profile status change.
// Rows are never updated or deleted.
model MerchantReviewHistory {
  id         String           @id @default(uuid()) @db.Uuid
  profileId  String           @db.Uuid
  fromStatus AccountStatus
  toStatus   AccountStatus
  note       String?
  actorType  ProfileActorType
  actorId    String?          @db.Uuid
  createdAt  DateTime         @default(now())

  profile MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([actorType, actorId])
  @@map("merchant_review_history")
}

// ============================================================
// MERCHANT LEDGER
// ============================================================

// One ledger per merchant. Balances are stored as integer tambala
// (1 MWK = 100 tambala) to avoid floating-point precision issues.
model MerchantLedger {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @unique @db.Uuid
  availableBalance Int      @default(0) // Settled funds available to withdraw
  pendingBalance   Int      @default(0) // Funds not yet settled
  currency         String   @default("MWK")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_ledgers")
}
