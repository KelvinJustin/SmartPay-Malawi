generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
}

// AccountStatus drives the entire KYC/onboarding lifecycle.
// It lives on MerchantProfile, not Merchant — the auth account
// has no concept of approval status, only the business profile does.
enum AccountStatus {
  PENDING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  INDIVIDUAL
  SOLE_TRADER
  PARTNERSHIP
  LIMITED_COMPANY
  NGO
}

enum DocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  PROOF_OF_ADDRESS
  DIRECTOR_ID
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ============================================================
// MERCHANT — AUTH IDENTITY ONLY
// ============================================================

// This model is purely the login identity.
// It knows nothing about business details, KYC, or balances.
// Those live on MerchantProfile and MerchantLedger respectively.
model Merchant {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String
  phone           String    @unique
  pinHash         String?
  emailVerifiedAt DateTime?
  deletedAt       DateTime? // Soft delete — never hard delete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  otpChallenges OtpChallenge[]
  revokedTokens RevokedToken[]
  profile       MerchantProfile?
  ledger        MerchantLedger?

  @@map("merchants")
}

// ============================================================
// OTP
// ============================================================

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  merchantId String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  sentAt     DateTime   @default(now())
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ============================================================
// TOKEN REVOCATION
// ============================================================

model RevokedToken {
  id         String   @id @default(uuid()) @db.Uuid
  jti        String   @unique @db.Uuid
  merchantId String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("revoked_tokens")
}

// ============================================================
// MERCHANT PROFILE — BUSINESS IDENTITY & KYC
// ============================================================

// Separate from Merchant intentionally — a merchant can have a
// login account without a business profile. The profile is created
// automatically at registration but starts empty.
model MerchantProfile {
  id         String @id @default(uuid()) @db.Uuid
  merchantId String @unique @db.Uuid

  // Business identity
  businessName           String
  tradingName            String?
  businessType           BusinessType
  businessRegistrationNo String?
  taxIdentificationNo    String?       // MRA TPIN
  merchantCategoryCode   String?       // ISO 18245 MCC e.g. "5411" for grocery
  industryDescription    String?

  // Contact and location
  supportEmail String?
  supportPhone String?
  websiteUrl   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  country      String  @default("MW")

  // Branding
  logoUrl String?

  // KYC/onboarding lifecycle — managed exclusively by admins
  // except for the initial submission trigger by the merchant.
  accountStatus   AccountStatus @default(PENDING_SUBMISSION)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?       // Admin user id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  documents     MerchantDocument[]
  reviewHistory MerchantReviewHistory[]

  @@map("merchant_profiles")
}

// ============================================================
// KYC DOCUMENTS
// ============================================================

// Documents belong to the profile, not the merchant directly,
// because they are part of the KYC/compliance record.
// One row per document type per profile — enforced by @@unique.
// Re-uploading a rejected document upserts the existing row.
model MerchantDocument {
  id        String         @id @default(uuid()) @db.Uuid
  profileId String         @db.Uuid
  type      DocumentType
  status    DocumentStatus @default(PENDING)

  // Files stored in private object storage (e.g. Cloudflare R2).
  // fileKey is the storage object key used for deletion.
  fileUrl       String
  fileKey       String
  mimeType      String
  fileSizeBytes Int

  rejectionNote String?
  reviewedAt    DateTime?
  reviewedById  String?   // Admin user id
  expiresAt     DateTime? // For ID documents that expire

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
  @@index([profileId, type])
  @@index([status])
  @@map("merchant_documents")
}

// ============================================================
// ADMIN REVIEW AUDIT TRAIL
// ============================================================

// Every status change on a profile is recorded here.
// This is append-only — rows are never updated or deleted.
model MerchantReviewHistory {
  id          String        @id @default(uuid()) @db.Uuid
  profileId   String        @db.Uuid
  fromStatus  AccountStatus
  toStatus    AccountStatus
  note        String?
  performedBy String        // Admin user id — no Admin model yet

  createdAt DateTime @default(now())

  profile MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("merchant_review_history")
}

// ============================================================
// MERCHANT LEDGER — BALANCE TRACKING
// ============================================================

// This is a placeholder for the balance/settlement layer.
// Settlement in SmartPay means: a transaction has been confirmed
// and the merchant is owed the money. It is a ledger concept,
// not a payout concept. Withdrawals (how the merchant gets their
// money out) are a separate module built later.
//
// One ledger per merchant. Balance is in Malawian Kwacha (MWK),
// stored as integer tambala (1 MWK = 100 tambala) to avoid
// floating point precision issues entirely.
model MerchantLedger {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @unique @db.Uuid

  // availableBalance: settled funds the merchant can withdraw
  // pendingBalance:   funds from transactions not yet settled
  // Both stored as integer tambala to avoid float precision issues.
  availableBalance Int      @default(0)
  pendingBalance   Int      @default(0)
  currency         String   @default("MWK")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_ledgers")
}