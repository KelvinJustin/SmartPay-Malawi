# ============================================================
# SMARTPAY MALAWI — ENVIRONMENT CONFIGURATION
# ============================================================
# Instructions:
# 1. Copy this file to `.env` in the project root.
# 2. Replace placeholder values with your local configuration.
# 3. Never commit `.env` or production secrets to Git.
# 4. Keep this file updated whenever new environment variables
#    are introduced.
#
# This file contains examples only. Do not use placeholder
# credentials in production.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

# Port on which the NestJS API listens.
# Local development: http://localhost:3000
PORT=3000

# Runtime environment.
# Allowed values: development, test, production
NODE_ENV=development


# ------------------------------------------------------------
# DATABASE — PostgreSQL
# ------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
#
# Format:
# postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Example for a local PostgreSQL installation:
# DATABASE_URL="postgresql://smartpay_user:change_me@localhost:5432/smartpay"
#
# Replace the username, password, host, port and database name
# with the values configured for your environment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"


# ------------------------------------------------------------
# REDIS — CACHE AND BACKGROUND JOBS
# ------------------------------------------------------------

# Hostname or IP address of the Redis server.
# Use localhost when Redis runs directly on your development
# machine. If using Docker Compose, the hostname may instead
# be the Redis service name, e.g. redis.
REDIS_HOST=localhost

# TCP port on which Redis accepts connections.
# Default Redis port: 6379
REDIS_PORT=6379

# Optional: Redis password, if authentication is configured.
# Leave unset for a local Redis instance without authentication.
# REDIS_PASSWORD=change_me


# ------------------------------------------------------------
# PASSWORD HASHING
# ------------------------------------------------------------

# Bcrypt work factor used when hashing merchant passwords.
# Higher values increase the time required to hash passwords.
# This must match the environment variable name actually read
# by your application.
#
# Example:
# PASS_SALTS=10
#
# NOTE: If your code uses bcrypt.hash(password, 10) directly,
# this variable currently has no effect until you read it
# in your authentication service.
PASS_SALTS=10


# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------

# Secret used to sign and verify JSON Web Tokens.
# Generate a unique, random secret for each environment.
#
# Generate locally with Node.js:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Do not use this placeholder as a real secret.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

# Lifetime of a signed access token.
# Must agree with the expiry configured in JwtModule.
# Example: 15m = 15 minutes
JWT_EXPIRES_IN=15m


# ------------------------------------------------------------
# FRONTEND / CORS
# ------------------------------------------------------------

# Exact origin of the React app that is allowed to call this API
# with cookies. No trailing slash. Vite's default is below.
# In production, set this to your real frontend URL (https://...).
FRONTEND_URL=http://localhost:5173


# ============================================================
# END OF EXAMPLE CONFIGURATION
# ============================================================